TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
TELEGRAM_ALLOWED_USER_IDS=123456789
REPOSITORIES_JSON={"agent":"/absolute/path/to/your/project"}
DEFAULT_REPOSITORY=agent
DATABASE_PATH=./data/agent.db
CODEX_MODEL=
CODEX_PATH=codex
CODEX_NETWORK_ACCESS=false
CODEX_ALLOW_SECRET_FILE_ACCESS=false
CODEX_SANDBOX_MODE=workspace-write
CODEX_APPROVAL_POLICY=untrusted
TASK_TIMEOUT_MS=1800000
APPROVAL_TIMEOUT_MS=300000
MAX_MESSAGE_LENGTH=12000
# Optional Jira Cloud integration; set all three or none.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
